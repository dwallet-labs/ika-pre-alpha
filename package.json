{
	"name": "ika-pre-alpha",
	"private": true,
	"license": "BSD-3-Clause-Clear",
	"type": "module",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"build": "pnpm --filter @ika.xyz/sdk-core build && pnpm --filter @ika.xyz/sdk-solana build",
		"test": "pnpm --filter @ika.xyz/sdk-core test && pnpm --filter @ika.xyz/sdk-solana test",
		"typecheck": "pnpm --filter @ika.xyz/sdk-solana typecheck && pnpm --filter @ika/solana-examples typecheck",
		"pack:sdk": "pnpm build && rm -rf packages && mkdir packages && for d in sdk/ika-wasm sdk/core sdk/solana; do (cd $d && pnpm pack --pack-destination ../../packages); done"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"esbuild": "^0.28.1",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.9"
	}
}
