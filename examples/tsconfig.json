{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "esnext"],
		"noUnusedLocals": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": ["_shared", "voting/e2e", "multisig/e2e"]
}
